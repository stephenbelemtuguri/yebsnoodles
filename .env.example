# YEBS Noodles Platform - Environment Configuration
# Copy this file to .env and fill in your actual values

# ═══════════════════════════════════════════════════════════
# SERVER CONFIGURATION
# ═══════════════════════════════════════════════════════════
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Base URL for the application (used in emails, webhooks, etc.)
BASE_URL=https://yebs-noodles.com

# ═══════════════════════════════════════════════════════════
# SECURITY & AUTHENTICATION
# ═══════════════════════════════════════════════════════════
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-64-chars-change-this-in-production
SESSION_SECRET=your-session-secret-min-32-chars-change-this
# Stable HMAC secret for admin/driver sessions. Required on Render so
# logins survive between instances. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
YEBS_AUTH_SECRET=

# Built-in administrator created when the database has no admins yet.
# Set a strong password; never commit it. The account is seeded on first boot.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Password recovery (Admin/Rider "Forgot your password?").
# Phone that receives the 6-digit admin recovery code over WhatsApp. If all
# delivery providers are unavailable, admins can use a short-lived code from
# restricted service logs; the code is never returned by the public API.
# Drivers use the phone number they signed up with.
ADMIN_RECOVERY_PHONE=
# Local development only: set to 1 to return the recovery code to requests
# received directly from localhost. Public requests never receive the code.
RECOVERY_SHOW_CODE=

# Bcrypt rounds (10-12 recommended, higher = more secure but slower)
BCRYPT_ROUNDS=12

# Session expiry in milliseconds (default: 12 hours)
SESSION_TTL_MS=43200000

# ═══════════════════════════════════════════════════════════
# SUPABASE (hosted Postgres + API)
# ═══════════════════════════════════════════════════════════
# Project: https://supabase.com/dashboard/project/dujmpwcarxliadnfdydr
SUPABASE_PROJECT_ID=dujmpwcarxliadnfdydr
SUPABASE_URL=https://dujmpwcarxliadnfdydr.supabase.co
# Publishable (public/anon) key - safe for the browser
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Server-only key (never in client code).
# EASIEST CONNECTION METHOD: Supabase -> Project Settings -> API Keys -> secret
# key, then run: npm run supabase:key -- "sb_secret_..."
# This uses HTTPS (PostgREST), so no database password or IPv6 pooler is needed.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATE_TABLE=yebs_state

# ═══════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════
# PostgreSQL connection string
# Supabase direct connection (port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.dujmpwcarxliadnfdydr.supabase.co:5432/postgres
# Supabase connection pooler (port 6543) - recommended for app servers.
# Replace [YOUR-PASSWORD] with the real database password from
# Supabase -> Project Settings -> Database -> Reset database password.
# When this URL is set the API stores data in Postgres and creates the
# yebs_state table automatically (no service_role key needed).
DATABASE_POOL_URL=postgresql://postgres.dujmpwcarxliadnfdydr:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Easiest: paste the raw database password here. It overrides the password in
# the URLs above and is URL-encoded automatically (@ : # / are safe).
DATABASE_PASSWORD=
# Used by Prisma for migrations
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.dujmpwcarxliadnfdydr.supabase.co:5432/postgres

# Redis for caching and sessions
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════════
# MTN MOBILE MONEY (GHANA)
# ═══════════════════════════════════════════════════════════
# Get credentials from: https://momodeveloper.mtn.com/
MOMO_ENABLED=true
MOMO_SUBSCRIPTION_KEY=your-mtn-momo-subscription-key
MOMO_API_USER=your-mtn-momo-api-user
MOMO_API_KEY=your-mtn-momo-api-key
MOMO_CALLBACK_HOST=https://yebs-noodles.com
# Sandbox: sandbox. Production: mtnghana
MOMO_TARGET_ENV=sandbox

# Your business MoMo number
MOMO_PAY_TO=0559103452
MOMO_MERCHANT_NAME=MATHEW TIA

# ═══════════════════════════════════════════════════════════
# GOOGLE MAPS & GEOCODING
# ═══════════════════════════════════════════════════════════
# Get API key from: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Geocoding service (google, mapbox, or nominatim)
GEOCODING_PROVIDER=google

# Mapbox (alternative to Google Maps)
MAPBOX_ACCESS_TOKEN=

# ═══════════════════════════════════════════════════════════
# SMS NOTIFICATIONS (Optional)
# ═══════════════════════════════════════════════════════════
SMS_ENABLED=false
SMS_PROVIDER=hubtel
# Ghana: hubtel, arkesel, or twilio

# Hubtel credentials (Ghana)
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=YEBS

# Twilio (International backup)
# Also used to send password-recovery codes to the account phone number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ═══════════════════════════════════════════════════════════
# EMAIL NOTIFICATIONS
# ═══════════════════════════════════════════════════════════
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
# Options: smtp, sendgrid, mailgun

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@yebs-noodles.com
SMTP_PASSWORD=your-email-app-password
EMAIL_FROM=YEBS Noodles <noreply@yebs-noodles.com>

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=YEBS Noodles

# ═══════════════════════════════════════════════════════════
# PUSH NOTIFICATIONS
# ═══════════════════════════════════════════════════════════
# Firebase Cloud Messaging for mobile push notifications
FCM_ENABLED=false
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# ═══════════════════════════════════════════════════════════
# FILE STORAGE
# ═══════════════════════════════════════════════════════════
# Where to store uploaded files (local, s3, cloudinary)
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads

# AWS S3 (for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=yebs-noodles-uploads
AWS_S3_REGION=eu-west-1

# Cloudinary (image optimization)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ═══════════════════════════════════════════════════════════
# MONITORING & LOGGING
# ═══════════════════════════════════════════════════════════
# Log level: error, warn, info, debug
LOG_LEVEL=info
LOG_FILE_ENABLED=true
LOG_DIR=./logs

# Sentry for error tracking (optional but recommended)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# ═══════════════════════════════════════════════════════════
# RATE LIMITING
# ═══════════════════════════════════════════════════════════
RATE_LIMIT_ENABLED=true
# Requests per window
RATE_LIMIT_MAX=100
# Window in milliseconds (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Login attempt limits
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000

# ═══════════════════════════════════════════════════════════
# BUSINESS RULES
# ═══════════════════════════════════════════════════════════
# Kitchen operating hours (24-hour format)
KITCHEN_OPEN_HOUR=18
KITCHEN_CLOSE_HOUR=21

# Delivery settings
DEFAULT_DELIVERY_FEE=15
MAX_DELIVERY_RADIUS_KM=10
MIN_ORDER_AMOUNT=20

# Order timeouts
ORDER_PENDING_TIMEOUT_MINUTES=30
ORDER_PREPARATION_TIMEOUT_MINUTES=45
DRIVER_ACCEPTANCE_TIMEOUT_MINUTES=5

# ═══════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════════
FEATURE_CASH_PAYMENT=true
FEATURE_MOMO_PAYMENT=true
FEATURE_CARD_PAYMENT=false
FEATURE_LOYALTY_PROGRAM=false
FEATURE_REFERRALS=false
FEATURE_SURGE_PRICING=false

# ═══════════════════════════════════════════════════════════
# DEVELOPMENT & DEBUG
# ═══════════════════════════════════════════════════════════
DEBUG=false
PRETTY_LOGS=false
DISABLE_AUTH=false
# WARNING: Only use DISABLE_AUTH in local development!

# Mock services for testing
MOCK_MOMO=false
MOCK_SMS=false
MOCK_GEOCODING=false

# ═══════════════════════════════════════════════════════════
# WHATSAPP CLOUD API (automatic order alerts — no redirect)
# ═══════════════════════════════════════════════════════════
# Create a Meta app → WhatsApp → API setup, then paste:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Kitchen number that receives every new order (international format, digits only)
WHATSAPP_TO=233559103452
WHATSAPP_API_VERSION=v20.0

# ═══════════════════════════════════════════════════════════
# DATABASE FILE (Render persistent disk / Docker volume)
# ═══════════════════════════════════════════════════════════
# Leave empty locally (uses ./database.json). On Render mount a disk at
# /var/data and set DB_PATH=/var/data/database.json so orders survive deploys.
DB_PATH=

# Shared pickup point + delivery fee are managed from the admin dashboard
# (Admin → Shared Pickup Point) and stored in the database, not here.
