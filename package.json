{
  "name": "yebs-noodles-platform",
  "version": "2.0.0",
  "description": "YEBS Noodles — Production-ready food delivery platform with real-time GPS tracking, MoMo payments, and driver management.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "security": "npm audit && snyk test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "build": "npm run db:migrate",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:logs": "pm2 logs yebs-api"
  },
  "keywords": ["food-delivery", "ghana", "noodles", "real-time-tracking", "momo-payment"],
  "author": "YEBS Noodles",
  "license": "PROPRIETARY",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "bcryptjs": "^3.0.3",
    "bull": "^4.12.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "prom-client": "^15.1.3",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.1",
    "@types/jest": "^29.5.12",
    "eslint": "^9.9.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prisma": "^5.19.0",
    "snyk": "^1.1293.1",
    "supertest": "^7.0.0"
  }
}
